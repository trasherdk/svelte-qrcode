{
	"name": "@trasherdk/svelte-qrcode",
	"description": "QR Code generator component for Svelte",
	"version": "0.2.3",
	"author": "TrasherDK",
	"license": "MIT",
	"access": "public",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trasherdk/svelte-qrcode.git"
	},
	"bugs": {
		"url": "https://github.com/trasherdk/svelte-qrcode/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"authentication",
		"2fa",
		"multifactor",
		"totp",
		"qr",
		"qrcode",
		"qrimage",
		"svg",
		"qrsvg"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"publish": "npm publish --access public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.6",
		"@sveltejs/kit": "^2.7.0",
		"@sveltejs/package": "^2.3.5",
		"@sveltejs/vite-plugin-svelte": "4.0.0-next.8",
		"@types/node": "^22.7.5",
		"publint": "^0.2.11",
		"svelte": "5.0.0-next.264",
		"svelte-check": "^4.0.5",
		"tslib": "^2.7.0",
		"typescript": "^5.6.3",
		"vite": "^5.4.8"
	},
	"peerDependencies": {
		"picomatch": "^3 || ^4",
		"svelte": "^4 || ^5"
	},
	"type": "module"
}